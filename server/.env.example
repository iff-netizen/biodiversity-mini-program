# Copy to .env locally. Never place credentials in the mini-program.
HOST=127.0.0.1
PORT=8787
APP_MODE=development
AI_PROVIDER=mock
AI_ENABLED=true
# Required only for real mode. See docs/ai-community-model-setup.md
AI_VENDOR=openai
# For DeepSeek: AI_VENDOR=deepseek, AI_BASE_URL=https://api.deepseek.com,
# AI_MODEL=deepseek-flash (official model ID verified 2026-11-03).
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=15000
# Default SQLite file: server/var/community.sqlite
# DATABASE_PATH=
# Development controls are off unless explicitly enabled. Loopback requests only.
DEV_CONTROLS=true
# Optional repeatable RNG (development only):
# DEV_RANDOM_SEED=20261103
