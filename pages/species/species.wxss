.page {
  padding: 30rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}


/* 顶部主卡片 */
.hero-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 28rpx;

  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}


.hero-placeholder {
  height: 420rpx;

  background-color: #e8f1eb;

  display: flex;
  align-items: center;
  justify-content: center;
}


.animal-icon {
  font-size: 150rpx;
}


.hero-content {
  padding: 30rpx;
}


.name-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}


.species-name {
  font-size: 46rpx;
  font-weight: 700;
  color: #222222;
}


.scientific-name {
  margin-top: 8rpx;

  font-size: 26rpx;

  color: #888888;

  font-style: italic;
}


.tag {
  padding: 8rpx 20rpx;

  background-color: #e8f1eb;

  color: #2f6b4f;

  border-radius: 30rpx;

  font-size: 24rpx;
}


/* 通用卡片 */
.section-card {
  background-color: #ffffff;

  border-radius: 28rpx;

  padding: 30rpx;

  margin-bottom: 24rpx;
}


.section-title {
  font-size: 34rpx;

  font-weight: 700;

  color: #222222;

  margin-bottom: 24rpx;
}


.info-row,
.record-row {
  display: flex;

  justify-content: space-between;

  align-items: flex-start;

  margin-top: 20rpx;

  gap: 30rpx;

  font-size: 27rpx;
}


.info-label {
  color: #777777;

  flex-shrink: 0;
}


.info-value {
  color: #333333;

  text-align: right;
}


.paragraph {
  font-size: 28rpx;

  line-height: 1.8;

  color: #555555;
}


.story-box {
  background-color: #f5f8f5;

  border-radius: 20rpx;

  padding: 24rpx;

  font-size: 27rpx;

  line-height: 1.8;

  color: #4e5c52;
}


.observe-button {
  margin-top: 32rpx;

  background-color: #2f6b4f;

  color: #ffffff;

  border-radius: 44rpx;

  font-size: 30rpx;
}

.english-name {
  margin-top: 10rpx;

  font-size: 28rpx;

  color: #555555;
}


.empty-box {
  padding: 30rpx;

  background-color: #f5f8f5;

  border-radius: 22rpx;

  text-align: center;
}


.empty-icon {
  font-size: 56rpx;

  margin-bottom: 16rpx;
}


.empty-title {
  font-size: 29rpx;

  font-weight: 600;

  color: #444444;
}


.empty-text {
  margin-top: 12rpx;

  font-size: 25rpx;

  line-height: 1.7;

  color: #888888;
}

.observation-summary {
  text-align: center;

  background-color: #f5f8f5;

  border-radius: 22rpx;

  padding: 28rpx;

  margin-bottom: 28rpx;
}


.summary-number {
  font-size: 52rpx;

  font-weight: 700;

  color: #2f6b4f;
}


.summary-label {
  margin-top: 8rpx;

  font-size: 24rpx;

  color: #777777;
}


.latest-link {
  margin-top: 26rpx;

  padding-top: 22rpx;

  border-top: 1rpx solid #eeeeee;

  text-align: center;

  font-size: 25rpx;

  color: #2f6b4f;
}