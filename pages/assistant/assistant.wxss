page { height: 100%; background: #f5f7f2; }
.assistant { height: 100vh; display: flex; flex-direction: column; }
.masthead {
  display: flex; align-items: center; gap: 12px; padding: 10px 16px;
  border-bottom: 1px solid #e5eae2; background: #fff; flex-shrink: 0;
}
.avatar {
  display: flex; align-items: center; justify-content: center; width: 40px; height: 40px;
  border-radius: 50%; background: #ffe285; color: #523d1d; font-size: 16px; font-weight: bold;
}
.heading { flex: 1; }
.name { color: #273c32; font-size: 17px; font-weight: bold; }
.ai-tag { font-size: 10px; color: #2d6447; background: #e2efe5; padding: 2px 6px; border-radius: 8px; margin-left: 3px; }
.caption { font-size: 12px; color: #626f67; }
.more { font-size: 15px; color: #2d6447; background: #f0f5ef; border-radius: 18px; padding: 0 12px; line-height: 34px; }
.timeline { flex: 1; height: 0; }
.content { padding: 16px; }
.welcome, .answer { background: #fff; border: 1px solid #e5eae2; color: #253b2f; }
.welcome { border-radius: 18px; padding: 14px; margin-bottom: 16px; line-height: 1.65; }
.user-line { display: flex; justify-content: flex-end; margin: 10px 0 8px; }
.bubble { padding: 11px 13px; border-radius: 16px; box-sizing: border-box; overflow-wrap: break-word; }
.user-text { background: #d9ebd9; color: #233d31; max-width: 84%; white-space: pre-wrap; word-break: break-word; }
.answer { max-width: 94%; margin-bottom: 16px; }
.answer-text { display: block; white-space: pre-wrap; word-break: break-word; line-height: 1.65; }
.source { font-weight: bold; font-size: 11px; color: #506c5b; margin-bottom: 5px; }
.row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 8px; }
.pill { font-size: 12px; line-height: 1.35; color: #315d46; padding: 6px 10px; background: #edf4eb; border-radius: 14px; max-width: 100%; }
.nav { background: #2f6b4f; color: #fff; }
.copy { color: #53665a; }
.status { color: #52685c; margin: 8px 0 15px; font-size: 13px; }
.questions-header { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.question-group { margin-top: 12px; }
.group-name { font-size: 12px; font-weight: bold; color: #52685c; margin-bottom: 4px; }
.question {
  display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left;
  font-size: 14px; line-height: 1.5; padding: 9px 12px; margin-bottom: 6px; background: #fff; color: #234433; border-radius: 11px;
}
.arrow { color: #4d755d; padding-left: 8px; }
.timeline-end { height: 1px; }
.jump { align-self: center; padding: 5px; }
.composer {
  display: flex; align-items: flex-end; gap: 8px; flex-shrink: 0; background: #fff; border-top: 1px solid #e5eae2;
  padding: 10px 12px; padding-bottom: calc(10px + env(safe-area-inset-bottom));
}
.composer.keyboard { padding-bottom: 10px; }
.draft {
  flex: 1; width: 0; min-height: 24px; max-height: 110px; padding: 9px 10px;
  line-height: 22px; background: #f1f5f0; border-radius: 12px; font-size: 14px; color: #263d30;
}
.send { flex-shrink: 0; background: #2f6b4f; color: #fff; font-size: 14px; padding: 0 14px; line-height: 40px; border-radius: 12px; }
.send[disabled] { background: #e7ece5; color: #627166; }
button { margin: 0; }
button::after { border: 0; }
.overlay { position: fixed; inset: 0; z-index: 4; background: rgba(24, 42, 32, .28); }
.history {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; border-radius: 20px 20px 0 0;
  background: #fff; padding: 16px 16px calc(16px + env(safe-area-inset-bottom));
}
.history-list { max-height: 52vh; margin-top: 8px; }
.history-item { display: flex; flex-direction: column; align-items: flex-start; width: 100%; font-size: 14px; line-height: 1.5; padding: 8px 10px; border-radius: 10px; margin-top: 5px; background: #edf4eb; text-align: left; }
