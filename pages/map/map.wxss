/* 页面整体 */
.container {
  padding: 32rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 顶部标题 */
.header {
  margin-bottom: 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f1f1f;
  line-height: 1.3;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #7a7a7a;
}


/* 地图卡片 */
.map-card {
  width: 100%;
  overflow: hidden;

  background-color: #ffffff;

  border-radius: 28rpx;

  margin-bottom: 36rpx;

  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}


/* 地图 */
.map {
  display: block;

  width: 100%;

  height: 720rpx;
}


/* 附近自然动态标题 */
.section-title {
  font-size: 34rpx;

  font-weight: 700;

  color: #222222;

  margin-bottom: 20rpx;
}


/* 预警卡片 */
.warning-card {
  background-color: #fff8e8;

  border-radius: 26rpx;

  padding: 28rpx 30rpx;

  margin-bottom: 24rpx;
}


/* 预警标题 */
.warning-title {
  font-size: 30rpx;

  font-weight: 600;

  color: #3a3325;

  line-height: 1.5;
}


/* 预警内容 */
.warning-text {
  margin-top: 12rpx;

  font-size: 26rpx;

  color: #8a806e;
}


/* 普通动物动态卡片 */
.card {
  background-color: #ffffff;

  border-radius: 26rpx;

  padding: 28rpx 30rpx;

  margin-bottom: 24rpx;

  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.04);
}


/* 动物信息 */
.animal-row {
  display: flex;

  justify-content: space-between;

  align-items: center;
}


.animal-name {
  font-size: 30rpx;

  font-weight: 600;

  color: #222222;
}


.animal-info {
  margin-top: 8rpx;

  font-size: 25rpx;

  color: #888888;
}


.time {
  font-size: 24rpx;

  color: #999999;
}


/* 点击地图 marker 后出现的详情卡片 */
.animal-detail-card {
  background-color: #ffffff;

  border-radius: 28rpx;

  padding: 32rpx;

  margin-bottom: 32rpx;

  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.06);
}


.card-header {
  display: flex;

  justify-content: space-between;

  align-items: flex-start;
}


.species-name {
  font-size: 42rpx;

  font-weight: 700;

  color: #222222;
}


.scientific-name {
  margin-top: 8rpx;

  font-size: 25rpx;

  color: #888888;

  font-style: italic;
}


.close-button {
  font-size: 44rpx;

  color: #999999;

  padding: 0 10rpx;
}


.species-tag {
  display: inline-block;

  margin-top: 20rpx;

  margin-bottom: 24rpx;

  padding: 8rpx 20rpx;

  background-color: #e8f1eb;

  color: #2f6b4f;

  border-radius: 30rpx;

  font-size: 24rpx;
}


.info-row {
  display: flex;

  justify-content: space-between;

  margin-top: 18rpx;

  font-size: 26rpx;
}


.label {
  color: #777777;
}


.description {
  margin-top: 26rpx;

  font-size: 27rpx;

  line-height: 1.7;

  color: #555555;
}


.detail-button {
  margin-top: 30rpx;

  background-color: #2f6b4f;

  color: #ffffff;

  border-radius: 40rpx;

  font-size: 28rpx;
}

.empty-map-card {
  background-color: #ffffff;

  border-radius: 26rpx;

  padding: 40rpx 30rpx;

  text-align: center;

  margin-bottom: 24rpx;
}


.empty-icon {
  font-size: 60rpx;

  margin-bottom: 16rpx;
}


.empty-title {
  font-size: 30rpx;

  font-weight: 600;

  color: #333333;
}


.empty-text {
  margin-top: 12rpx;

  font-size: 25rpx;

  line-height: 1.7;

  color: #888888;
}


.observe-button {
  margin-top: 26rpx;

  background-color: #2f6b4f;

  color: #ffffff;

  border-radius: 40rpx;

  font-size: 28rpx;
}

.species-link {
  margin-top: 24rpx;

  text-align: center;

  font-size: 25rpx;

  color: #2f6b4f;

  padding: 10rpx 0;
}