<!-- pages/identify/identify.wxml -->

<view class="container">


<!-- 标题 -->

<view class="title">
  发现了什么？
</view>

<view class="subtitle">
  选一张动物照片，千问视觉模型会给出识别建议
</view>



<!-- 图片上传 -->

<view
  class="upload-box"
  bindtap="chooseImage"
>

  <image
    wx:if="{{imagePath}}"
    src="{{imagePath}}"
    mode="aspectFill"
    class="preview-image"
  />


  <view
    wx:else
    class="upload-placeholder"
  >

    <view class="camera">
      📷
    </view>

    <view>
      拍照或上传图片
    </view>

  </view>

</view>



<!-- 开始识别 -->

<button
  class="identify-button"
  bindtap="identifyAnimal"
  loading="{{isIdentifying}}"
  disabled="{{isIdentifying}}"
>
  {{isIdentifying ? '正在识别' : '开始识别'}}
</button>



<view wx:if="{{identificationError}}" class="result-card">
  {{identificationError}}
</view>

<!-- ========================= -->
<!-- AI 识别结果 -->
<!-- ========================= -->

<view
  wx:if="{{result}}"
  class="result-card"
>

  <view class="new-tag">AI 识别建议</view>
  <view class="selector-title">{{result.label}}</view>

  <view wx:for="{{result.candidates}}" wx:key="id" class="confirm-area">
    <view class="option-name">{{item.name}}</view>
    <view class="scientific-name">{{item.scientificName}}</view>
    <view class="description">照片依据：{{item.evidence}}</view>
    <button
      wx:if="{{!confirmedSpecies && !showSpeciesSelector}}"
      class="confirm-button"
      data-name="{{item.name}}"
      bindtap="confirmAIResult"
    >
      选为观察物种
    </button>
  </view>

  <view wx:if="{{result.tip}}" class="description">{{result.tip}}</view>

  <button
    wx:if="{{result.status !== 'no_animal' && !confirmedSpecies && !showSpeciesSelector}}"
    class="correction-button"
    bindtap="showCorrectionList"
  >
    从图鉴手动选择
  </button>


  <!-- ========================= -->
  <!-- 物种纠错列表 -->
  <!-- ========================= -->

  <view
    wx:if="{{showSpeciesSelector}}"
    class="species-selector"
  >

    <view class="selector-title">
      请选择你实际观察到的物种
    </view>


    <view class="selector-tip">
      你的选择将作为本次观察的最终物种记录
    </view>


    <view class="species-grid">

      <view
        wx:for="{{speciesList}}"
        wx:key="id"
        class="species-option"
        data-name="{{item.name}}"
        bindtap="selectSpecies"
      >

        <view class="option-emoji">
          {{item.emoji || '🌿'}}
        </view>


        <view class="option-text">

          <view class="option-name">
            {{item.name}}
          </view>


          <view class="option-scientific">
            {{item.scientificName}}
          </view>

        </view>

      </view>

    </view>

  </view>



  <!-- ========================= -->
  <!-- 最终确认结果 -->
  <!-- ========================= -->

  <view
    wx:if="{{confirmedSpecies}}"
    class="confirmed-card"
  >

    <view class="confirmed-label">
      ✓ 最终确认物种
    </view>


    <view class="confirmed-name">
      {{confirmedSpecies.name}}
    </view>


    <view class="confirmed-scientific">
      {{confirmedSpecies.scientificName}}
    </view>



    <!-- 用户纠正过 -->

    <view
      wx:if="{{result.chineseName && confirmedSpecies.name !== result.chineseName}}"
      class="corrected-tip"
    >
      AI 原始识别结果为「{{result.chineseName}}」，
      你已将本次观察纠正为「{{confirmedSpecies.name}}」。
    </view>



    <!-- AI 正确 -->

    <view
      wx:else
      class="correct-tip"
    >
      你已选定本次观察物种。
    </view>



    <button
      class="change-button"
      bindtap="changeConfirmedSpecies"
    >
      修改物种
    </button>


    <button
      class="save-button"
      bindtap="saveObservation"
    >
      保存观察记录
    </button>


    <button
      class="detail-button"
      bindtap="goToSpeciesDetail"
    >
      查看{{confirmedSpecies.name}}物种详情
    </button>

  </view>


</view>


</view>