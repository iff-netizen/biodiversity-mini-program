.container {
  padding: 32rpx;
  padding-bottom: 60rpx;
}


.header {
  margin-bottom: 30rpx;
}


.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #222222;
}


.subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #777777;
}


/* 动态卡片 */
.post-card {
  background-color: #ffffff;

  border-radius: 28rpx;

  padding: 28rpx;

  margin-bottom: 26rpx;

  box-shadow:
    0 6rpx 24rpx
    rgba(0, 0, 0, 0.04);
}


/* 用户信息 */
.post-header {
  display: flex;

  align-items: center;

  margin-bottom: 22rpx;
}


.avatar {
  width: 76rpx;

  height: 76rpx;

  border-radius: 50%;

  background-color: #e8f1eb;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 36rpx;

  margin-right: 18rpx;
}


.username {
  font-size: 28rpx;

  font-weight: 600;

  color: #333333;
}


.post-time {
  margin-top: 6rpx;

  font-size: 23rpx;

  color: #999999;
}


/* 用户图片 */
.post-image {
  width: 100%;

  height: 420rpx;

  border-radius: 22rpx;

  margin-bottom: 22rpx;

  background-color: #eeeeee;
}


/* 正文 */
.post-content {
  font-size: 29rpx;

  line-height: 1.7;

  color: #333333;

  margin-bottom: 22rpx;
}


/* 物种信息 */
.species-box {
  display: flex;

  justify-content: space-between;

  align-items: center;

  background-color: #f5f8f5;

  border-radius: 20rpx;

  padding: 22rpx 24rpx;

  margin-bottom: 20rpx;
}


.species-name {
  font-size: 29rpx;

  font-weight: 600;

  color: #2f6b4f;
}


.scientific-name {
  margin-top: 5rpx;

  font-size: 22rpx;

  color: #888888;

  font-style: italic;
}


.species-arrow {
  font-size: 42rpx;

  color: #999999;
}


/* 地点 + AI */
.meta-row {
  display: flex;

  justify-content: space-between;

  font-size: 24rpx;

  color: #888888;
}


/* 空状态 */
.empty-card {
  margin-top: 100rpx;

  text-align: center;

  background-color: #ffffff;

  border-radius: 28rpx;

  padding: 60rpx 30rpx;
}


.empty-icon {
  font-size: 70rpx;
}


.empty-title {
  margin-top: 20rpx;

  font-size: 31rpx;

  font-weight: 600;

  color: #333333;
}


.empty-text {
  margin-top: 14rpx;

  font-size: 25rpx;

  line-height: 1.7;

  color: #888888;
}

.interaction-row {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-top: 22rpx;

  padding-top: 20rpx;

  border-top: 1rpx solid #eeeeee;
}


.interaction-item {
  font-size: 24rpx;

  color: #777777;

  padding: 10rpx 4rpx;
}


.interaction-item.active {
  color: #2f6b4f;

  font-weight: 600;
}


.comment-box {
  margin-top: 18rpx;

  padding: 20rpx;

  background-color: #f5f8f5;

  border-radius: 18rpx;
}


.comment-item {
  margin-bottom: 12rpx;

  font-size: 25rpx;

  line-height: 1.6;
}


.comment-item:last-child {
  margin-bottom: 0;
}


.comment-user {
  color: #2f6b4f;

  font-weight: 600;
}


.comment-content {
  color: #444444;
}